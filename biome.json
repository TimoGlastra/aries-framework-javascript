{
  "$schema": "https://biomejs.dev/schemas/1.4.1/schema.json",
  "formatter": {
    "enabled": true,
    "include": ["**/*.+(js|json|ts|md|yml|yaml)"],
    "ignore": ["build/**", "node_modules/**"],
    "lineWidth": 120,
    "indentStyle": "space",
    "formatWithErrors": true
  },

  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "include": ["**/*.+(js|json|ts|md|yml|yaml)"],
    "ignore": ["build/**", "node_modules/**"],
    "rules": {
      "recommended": true
    }
  },
  "json": {
    "parser": {
      "allowComments": true
    }
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded",
      "quoteStyle": "single",
      "trailingComma": "es5"
    },
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  }
}
